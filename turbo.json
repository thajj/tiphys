{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@argocanvas/workflow-builder#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-server/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tailwind.config.cjs", "$TURBO_ROOT$/postcss.config.cjs", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": [
        "coverage/**"
      ]
    }
  }
}
