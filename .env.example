# Platform Dev Gateway Configuration
# Copy this file to .env.local and fill in your values.
# These values are consumed by the Vite dev gateway, not exposed to the browser bundle.

# Argo Server endpoint used by the same-origin dev gateway.
# Set this to your Argo Server URL; a local port-forward commonly uses :2746.
ARGO_ENDPOINT=http://127.0.0.1:2746

# Default namespace for local development
ARGO_NAMESPACE=default

# Bearer token for Argo Server authentication.
# Get your token with: kubectl -n argo exec deploy/argo-server -- argo auth token
# Raw `v2:...` and full `Bearer v2:...` formats are both accepted here.
ARGO_TOKEN=

# Optional AI: set both values to enable generation, editing, and analysis.
# Choose a currently available text model for your Google project.
# Bare model IDs and models/<ID> resource names are accepted.
# Model availability: https://ai.google.dev/gemini-api/docs/deprecations/
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional backward-compatible aliases if you still have older local env files
VITE_ARGO_ENDPOINT=http://127.0.0.1:2746
VITE_ARGO_NAMESPACE=default
# Keep credentials in ARGO_TOKEN. Never prefix secrets with VITE_.
