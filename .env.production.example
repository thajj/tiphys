# Inject these at runtime using Kubernetes Secrets / ConfigMaps.
PUBLIC_URL=https://workflows.example.com
ARGO_ENDPOINT=https://argo-server.argo.svc.cluster.local:2746
ARGO_NAMESPACE=workflows
ARGO_TOKEN=
AUTH_PROXY_SECRET=
# Comma-separated OIDC group names that may mutate resources. Empty means all users read-only.
AUTH_EDITOR_GROUPS=workflow-editors
DATA_DIR=/data
STATIC_DIR=/app/public
PORT=3000
UPSTREAM_TIMEOUT_MS=30000
GEMINI_API_KEY=
GEMINI_MODEL=
# For private Argo certificate authorities, mount a PEM file and set NODE_EXTRA_CA_CERTS.
